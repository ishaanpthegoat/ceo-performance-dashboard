{
  "name": "ceo-performance-dashboard",
  "version": "0.1.0",
  "description": "CEO performance dashboard — tenure, shareholder returns, capital allocation, acquisitions, buybacks and executive pay.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b",
    "sync": "node scripts/sync.mjs",
    "sync:financials": "node scripts/sync.mjs --only=financials",
    "sync:prices": "node scripts/sync.mjs --only=prices"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "private": true,
  "type": "module"
}
